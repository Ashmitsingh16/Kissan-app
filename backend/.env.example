MONGODB_URI=mongodb://localhost:27017/kisan-app
JWT_SECRET=your_super_secret_jwt_key_change_this
PORT=5000

# Demo Mode - Set to 'true' to allow random/fake Aadhar, PAN, Phone, Account numbers for testing
DEMO_MODE=false

# Transactions require MongoDB Atlas or a replica set (not standalone MongoDB).
# Set only to the exact number of trusted reverse proxies in front of this API.
TRUST_PROXY_HOPS=0

NODE_ENV=development
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
OPENWEATHER_API_KEY=
# Separate server key from the referrer-restricted browser Maps key.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_BROWSER_KEY=
SUPPORT_EMAIL=
EMAIL_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
